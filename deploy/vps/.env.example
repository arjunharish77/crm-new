# Copy to deploy/vps/.env on the VPS and replace every secret before starting.

# Both domains are reverse-proxied by Caddy to the same Next.js process (see
# deploy/vps/caddy/Caddyfile) -- there is no separate "API server" to stand up.
APP_DOMAIN=app.unnatify.com
API_DOMAIN=api.unnatify.com
UNNATIVIDYA_DOMAIN=unnatividya.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=crm
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

UNNATIVIDYA_POSTGRES_DB=unnatividya
UNNATIVIDYA_POSTGRES_USER=unnatividya_app
UNNATIVIDYA_POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgresql://crm_app:replace-with-a-long-random-password@postgres:5432/crm
DIRECT_DATABASE_URL=postgresql://crm_app:replace-with-a-long-random-password@postgres:5432/crm
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

NODE_ENV=production
DATA_ACCESS_MODE=postgres
# Needed once, for the very first migration run against a brand-new empty database --
# baselines the pre-migration-system Supabase-era schema (Tenant, User, Lead, etc.),
# then migrations/*.sql apply cleanly on top. Baked into the image at db-bootstrap/base-schema.sql.
BASE_SCHEMA_SQL_PATH=db-bootstrap/base-schema.sql
JWT_SECRET=replace-with-a-long-random-secret
AUTH_DEBUG=false
NEXT_PUBLIC_API_DEBUG=false

FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=/app/storage

APP_INTERNAL_URL=http://web:3000
WORKER_REPEAT_MS=60000
WORKER_CONCURRENCY=5

AUTOMATION_CRON_SECRET=replace-with-a-long-random-secret
TASKS_CRON_SECRET=replace-with-a-long-random-secret
REPORTING_CRON_SECRET=replace-with-a-long-random-secret
COMMUNICATIONS_CRON_SECRET=replace-with-a-long-random-secret
COMMUNICATIONS_WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-secret

# Internal-only Python ML service (deploy/vps/docker-compose.yml's ml-service, not exposed
# publicly) -- used by predictive scoring as a third candidate alongside the built-in JS
# heuristic/logistic-regression scoring. Optional: recompute falls back to those two
# candidates if this is unreachable.
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_SECRET=replace-with-a-long-random-secret

# SMTP, WhatsApp, and SMS provider credentials are stored in the CRM connectors.
# Keep provider API keys out of this file unless a connector explicitly needs env-level defaults.

# Unnati Vidya website. Uses the same Postgres server, but a separate database/user.
NEXT_PUBLIC_UNNATIVIDYA_SITE_URL=https://unnatividya.com
UNNATIVIDYA_DATABASE_URL=postgresql://unnatividya_app:replace-with-a-long-random-password@postgres:5432/unnatividya
UNNATIVIDYA_SESSION_SECRET=replace-with-a-long-random-secret
UNNATIVIDYA_CMS_SETUP_ENABLED=true
UNNATIVIDYA_CRM_SYNC_WORKER_ENABLED=false
UNNATIVIDYA_CRM_SYNC_INTERVAL_MS=60000
UNNATIVIDYA_CRM_SYNC_BATCH_SIZE=25
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_KEY=replace-with-zeptomail-api-key
ZEPTOMAIL_FROM_EMAIL=info@unnatividya.com
ZEPTOMAIL_FROM_NAME=Unnati Vidya
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
