# Copy to deploy/vps/.env on the VPS and replace every secret before starting.
#
# F19 fix (WP06): this is still the one file an operator edits for values, but
# docker-compose.yml no longer hands every service the whole thing via a wholesale
# `env_file: [.env]`. Only web/worker (the main CRM app, which legitimately needs most of
# this) still do that; postgres/redis/ml-service/unnatividya-web/unnatividya-crm-worker/
# caddy each get an explicit, narrowed `environment:` list in docker-compose.yml that
# references `${VAR}` substitution out of this same file -- see the comments on each
# service there for exactly which vars it gets and why.

# Both domains are reverse-proxied by Caddy to the same Next.js process (see
# deploy/vps/caddy/Caddyfile) -- there is no separate "API server" to stand up.
APP_DOMAIN=app.unnatify.com
API_DOMAIN=api.unnatify.com
UNNATIVIDYA_DOMAIN=unnatividya.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=crm
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

UNNATIVIDYA_POSTGRES_DB=unnatividya
UNNATIVIDYA_POSTGRES_USER=unnatividya_app
UNNATIVIDYA_POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgresql://crm_app:replace-with-a-long-random-password@postgres:5432/crm
DIRECT_DATABASE_URL=postgresql://crm_app:replace-with-a-long-random-password@postgres:5432/crm
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379
DATABASE_SSL=false
# With DATABASE_SSL=true, set to false only for a database with a self-signed certificate.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=20
# Connections kept for live updates (the notifications stream). Default 3.
# DATABASE_REALTIME_POOL_MAX=
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

NODE_ENV=production
DATA_ACCESS_MODE=postgres
# Needed once, for the very first migration run against a brand-new empty database --
# baselines the pre-migration-system Supabase-era schema (Tenant, User, Lead, etc.),
# then migrations/*.sql apply cleanly on top. Baked into the image at db-bootstrap/base-schema.sql.
BASE_SCHEMA_SQL_PATH=db-bootstrap/base-schema.sql
JWT_SECRET=replace-with-a-long-random-secret
# Required in production, separate from JWT_SECRET so it can be rotated safely. On an existing
# install set both to the CURRENT JWT_SECRET value (see docs/SETUP_REQUIREMENTS_GUIDE.md 1.1);
# on a fresh install generate new ones. Never change MARKETPLACE_SECRET_ENCRYPTION_KEY afterwards:
# stored integration secrets would become unreadable.
MARKETPLACE_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-secret
FILE_DOWNLOAD_SIGNING_SECRET=replace-with-a-long-random-secret
# One-time token the first-run setup page asks for (create the first platform admin).
BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
AUTH_DEBUG=false
NEXT_PUBLIC_API_DEBUG=false

FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=/app/storage

APP_INTERNAL_URL=http://web:3000
WORKER_REPEAT_MS=60000
WORKER_CONCURRENCY=5
# Optional worker tuning (defaults shown): per-class concurrency (WORKER_CONCURRENCY_REALTIME,
# _OPERATIONAL, _HEAVY, _ML), the older names WORKER_CONCURRENCY_BACKGROUND and WORKER_INTERVAL_MS,
# and how many exports/imports one workspace may run at once.
# WORKER_CONCURRENCY_BACKGROUND=
# WORKER_INTERVAL_MS=
# JOB_FAIRNESS_HEAVY_MAX_CONCURRENT_PER_TENANT=2
# File the worker touches every 30 s; its container health check reads it.
# WORKER_HEARTBEAT_FILE=/tmp/crm-worker-heartbeat
# Days a finished export file can still be downloaded.
# EXPORT_FILE_RETENTION_DAYS=7
# Queries slower than this (ms) are logged; much slower ones go to Sentry too.
# SLOW_QUERY_THRESHOLD_MS=1000
# Database-level workspace isolation (round-2 plan S5). Leave unset until S5 is switched on.
# ENFORCE_TENANT_RLS=false
# TENANT_DATABASE_URL=

# Error tracking (round-2 plan O5, docs/SETUP_REQUIREMENTS_GUIDE.md section 2). Optional: without
# them errors are only in the container logs.
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=
SENTRY_ENVIRONMENT=production

# Image to run (round-2 plan O4). deploy/vps/deploy.sh sets CRM_VERSION for each deploy.
CRM_IMAGE=ghcr.io/arjunharish77/crm-new
CRM_VERSION=latest

AUTOMATION_CRON_SECRET=replace-with-a-long-random-secret
TASKS_CRON_SECRET=replace-with-a-long-random-secret
REPORTING_CRON_SECRET=replace-with-a-long-random-secret
COMMUNICATIONS_CRON_SECRET=replace-with-a-long-random-secret
COMMUNICATIONS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Internal-only Python ML service (deploy/vps/docker-compose.yml's ml-service, not exposed
# publicly) -- used by predictive scoring as a third candidate alongside the built-in JS
# heuristic/logistic-regression scoring. Optional: recompute falls back to those two
# candidates if this is unreachable.
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_SECRET=replace-with-a-long-random-secret

# Platform account emails (password-reset links). Leave SYSTEM_SMTP_HOST empty to keep
# "Forgot password?" hidden; admins can still create reset links in Settings › Users.
# Single-quote a password that contains $ or spaces.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
# "true" for implicit TLS (usually port 465); otherwise STARTTLS is required.
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_EMAIL_FROM="Unnatify <no-reply@unnatify.com>"
# Public address of the CRM, used for links and the logo in emails. docker-compose.yml also
# passes https://${APP_DOMAIN} to the web image build for link-preview (share) image URLs.
APP_URL=https://app.unnatify.com

# SMTP, WhatsApp, and SMS provider credentials are stored in the CRM connectors.
# Keep provider API keys out of this file unless a connector explicitly needs env-level defaults.

# Unnati Vidya website. Uses the same Postgres server, but a separate database/user.
NEXT_PUBLIC_UNNATIVIDYA_SITE_URL=https://unnatividya.com
UNNATIVIDYA_DATABASE_URL=postgresql://unnatividya_app:replace-with-a-long-random-password@postgres:5432/unnatividya
UNNATIVIDYA_SESSION_SECRET=replace-with-a-long-random-secret
UNNATIVIDYA_CMS_SETUP_ENABLED=true
# Read by apps/unnatividya/src/app/api/admin/setup/route.ts as the one-use admin-setup
# token (UNNATIVIDYA_CMS_SETUP_ENABLED above is not actually read by any app code -- this
# is the var that gates/authenticates that route). Added here because
# deploy/vps/docker-compose.yml's unnatividya-web now passes through an explicit,
# narrowed environment: list (F19) instead of the whole file, so every var it needs must
# be named in this file for ${VAR} substitution to resolve to something non-empty.
UNNATIVIDYA_CMS_SETUP_TOKEN=
UNNATIVIDYA_CRM_SYNC_WORKER_ENABLED=false
UNNATIVIDYA_CRM_SYNC_INTERVAL_MS=60000
UNNATIVIDYA_CRM_SYNC_BATCH_SIZE=25
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_KEY=replace-with-zeptomail-api-key
ZEPTOMAIL_FROM_EMAIL=info@unnatividya.com
ZEPTOMAIL_FROM_NAME=Unnati Vidya
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
