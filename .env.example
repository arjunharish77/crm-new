# Standard Next.js/Node env flag. Gates auth-debug exposure, cookie `secure` flag, and error detail exposure (dev vs prod).
NODE_ENV=development

# Set to "true" to force auth-debug info on login failures even outside development.
AUTH_DEBUG=false

# Secret used to sign/verify the app's custom auth JWT (see src/lib/server/auth.ts).
JWT_SECRET=replace-with-a-long-random-secret

# Data access mode. Direct Postgres is the production target; "supabase" is legacy migration fallback only.
DATA_ACCESS_MODE=postgres

# Direct Postgres migration/local development settings. Local development uses native Postgres, not Docker.
LOCAL_POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql://crm_app:crm_app@localhost:5432/crm_dev
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_dev
DATABASE_SSL=false
# Only used when DATABASE_SSL=true. Keep at the default (true) unless connecting to a
# Postgres host with a self-signed/internal CA cert you've explicitly chosen to trust.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_REALTIME_POOL_MAX=3
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Optional executable base schema SQL exported from Supabase. The checked-in SCHEMA.md is documentation, not executable SQL.
BASE_SCHEMA_SQL_PATH=

# One-time Supabase-to-local export/import helpers. Use Supabase's direct Postgres connection string here, not the REST URL.
SUPABASE_DATABASE_URL=
SUPABASE_SCHEMA_DUMP_PATH=./db-dumps/supabase-schema.sql
SUPABASE_DATA_DUMP_PATH=./db-dumps/supabase-data.sql
PG_DUMP_PATH=
PSQL_PATH=

# Local direct-Postgres file storage target. Replaces Supabase Storage after the storage cutover batch.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=./storage

# BullMQ worker settings. Local development uses native Redis; VPS uses the redis service in deploy/vps/docker-compose.yml.
REDIS_URL=redis://localhost:6379
WORKER_REPEAT_MS=60000
WORKER_CONCURRENCY=5

# Shared secret the BullMQ worker passes (header x-automation-cron-secret or ?secret=) to trigger due-automation processing without a user session.
AUTOMATION_CRON_SECRET=replace-with-a-long-random-secret

# Shared secret for task reminder processing.
TASKS_CRON_SECRET=replace-with-a-long-random-secret

# Shared secret for report rollup/schedule processing.
REPORTING_CRON_SECRET=replace-with-a-long-random-secret

# Shared secret for queued Email/WhatsApp/SMS processing.
COMMUNICATIONS_CRON_SECRET=replace-with-a-long-random-secret

# Shared secret expected by generic WhatsApp/SMS delivery webhooks.
COMMUNICATIONS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Shared secret expected by inbound lead and telephony webhooks.
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-secret

# Legacy Supabase export-only setting. Not required for direct-Postgres production runtime.
# Use Supabase's direct database connection string here only while exporting the old managed database.
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-...pooler.supabase.com:5432/postgres

# Client-exposed (NEXT_PUBLIC_) debug flag for the browser-side API client (src/lib/api.ts).
# Leave unset/false in production -- it logs request/response detail to the browser console.
NEXT_PUBLIC_API_DEBUG=false
