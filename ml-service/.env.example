# The service also reads the app's own .env (see app/config.py), so in local dev you
# usually don't need this file at all -- it's here for running ml-service standalone
# (e.g. in Docker) without the rest of the Node app's env file.

DIRECT_DATABASE_URL=postgresql://crm_app:password@localhost:5432/crm_dev
ML_SERVICE_SECRET=replace-with-a-long-random-secret
FILE_STORAGE_ROOT=../storage
ML_SERVICE_PORT=8000
ML_EMBEDDING_MODEL=all-MiniLM-L6-v2
